# Local development. Two paths:
#
#   Path A (zero credentials): ATTEST_DEMO=1 ATTEST_STORE=memory — no key, no cloud.
#   Path B (drive the real fleet): set the two below.
#
# Gemini roles (controller, workers, vision) run on VERTEX AI when GOOGLE_CLOUD_PROJECT is
# set, billed to that project. Run `gcloud auth application-default login` once for ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# The Gemma auditor is NOT served as a Vertex publisher model, so it uses the Gemini
# Developer API. This key is only ever used for the auditor.
GOOGLE_API_KEY=your-ai-studio-key

# Set ATTEST_USE_VERTEX=0 to force everything onto the Developer API key instead.
# ATTEST_USE_VERTEX=1

ATTEST_STORE=memory
# ATTEST_STORE=firestore + ATTEST_FIRESTORE_DATABASE=attest-fleet on Cloud Run

ATTEST_FAULT_RATE=0
